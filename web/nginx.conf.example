# Serving the web port with Nginx, privately. Replace yakumo.example.com, get a
# certificate (certbot certonly --webroot -w /var/www/yakumo-acme -d ...), and
# create the password file with htpasswd before opening the page:
#
#   htpasswd -c /etc/nginx/yakumo.htpasswd <user>
#   chgrp www-data /etc/nginx/yakumo.htpasswd && chmod 640 /etc/nginx/yakumo.htpasswd
#
# /var/www/yakumo holds Yakumo.html, Yakumo.js, Yakumo.wasm, fonts/ and game/
# (EBOOT.ELF and disc.iso). The game folder is derived from your own disc
# image: keep the site behind the password, for yourself.

server {
    listen 80;
    listen [::]:80;
    server_name yakumo.example.com;
    # Certificate renewals.
    location /.well-known/acme-challenge/ { root /var/www/yakumo-acme; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name yakumo.example.com;

    ssl_certificate /etc/letsencrypt/live/yakumo.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/yakumo.example.com/privkey.pem;

    root /var/www/yakumo;

    # Everything behind a password. Until the file exists, every request is refused.
    auth_basic "Yakumo";
    auth_basic_user_file /etc/nginx/yakumo.htpasswd;

    # Threads need a cross-origin isolated page (SharedArrayBuffer).
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "require-corp" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    # Nginx's mime.types maps .wasm to application/wasm, which streaming
    # compilation needs.
    gzip on;
    gzip_types application/wasm application/javascript text/css;
    gzip_min_length 1024;

    location = / { return 302 /Yakumo.html?game=game; }
    location / { try_files $uri =404; }

    # Ad hoc play: the gateway in web/adhoc-gateway, on 127.0.0.1:27380, which
    # carries the page's WebSockets to the ad hoc server. Behind the same
    # password as the page. Remove this block to leave ad hoc play off.
    location /adhoc/ {
        proxy_pass http://127.0.0.1:27380;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        # The relay keeps quiet connections open; the gateway pings every 20 s.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
